diff --git a/drizzle/migrations/0026_pbx_wrapup.sql b/drizzle/migrations/0026_pbx_wrapup.sql
new file mode 100644
--- /dev/null
+++ b/drizzle/migrations/0026_pbx_wrapup.sql
@@ -0,0 +1,100 @@
+alter table pbx_private.calls add column wrapup boolean not null default false,
+  add column ended_at timestamptz;
+
+create function public.pbx_wrapup_ready(p_id uuid, p_campaign_lead uuid)
+returns boolean language sql stable security definer set search_path = '' as $$
+  select exists (
+    select 1 from pbx_private.calls pc join public.attendances a on a.id=pc.attendance_id
+    join public.campaign_leads cl on cl.lead_id=a.lead_id and cl.campaign_id=a.campaign_id and cl.tenant_id=a.tenant_id
+    where pc.attendance_id=p_id and cl.id=p_campaign_lead and pc.wrapup and pc.ended_at is not null
+      and a.user_id=auth.uid() and pc.tenant_id=public.current_tenant_id() and a.finished_at is null
+  )
+$$;
+revoke all on function public.pbx_wrapup_ready(uuid,uuid) from public,anon;
+grant execute on function public.pbx_wrapup_ready(uuid,uuid) to authenticated;
+
+create function public.finish_pbx_attendance(p_input jsonb)
+returns uuid language plpgsql security invoker set search_path=public as $$
+declare
+  a public.attendances;
+  cl public.campaign_leads;
+  st public.service_statuses;
+  memo text := nullif(trim(p_input->>'notes'),'');
+  appointment jsonb := nullif(p_input->'appointment','null'::jsonb);
+begin
+  select * into cl from public.campaign_leads where id=(p_input->>'campaignLeadId')::uuid
+    and tenant_id=public.current_tenant_id() for update;
+  select * into a from public.attendances where id=(p_input->>'pbxAttendanceId')::uuid
+    and tenant_id=cl.tenant_id and user_id=auth.uid() and lead_id=cl.lead_id and campaign_id=cl.campaign_id for update;
+  if a.id is null then raise exception 'Atendimento indisponível'; end if;
+  if a.finished_at is not null then return a.id; end if;
+  if not public.pbx_wrapup_ready(a.id,cl.id) then raise exception 'Aguarde o encerramento da ligação'; end if;
+  select * into st from public.service_statuses where id=(p_input->>'statusId')::uuid
+    and tenant_id=a.tenant_id and active and deleted_at is null;
+  if st.id is null or st.counts_as_sale then raise exception 'Selecione uma tabulação válida'; end if;
+  if length(memo)>10000 or (st.requires_note and memo is null) then raise exception 'Informe uma observação válida'; end if;
+  if st.requires_appointment and appointment is null then raise exception 'Informe a data e a hora do retorno'; end if;
+  if appointment is not null then
+    if coalesce(appointment->>'priority','') not in ('baixa','normal','alta') or appointment->>'scheduledAt' is null then raise exception 'Confira o agendamento'; end if;
+    insert into public.appointments(tenant_id,lead_id,campaign_id,attendance_id,user_id,scheduled_at,notes,priority)
+      values(a.tenant_id,a.lead_id,a.campaign_id,a.id,a.user_id,(appointment->>'scheduledAt')::timestamptz,memo,appointment->>'priority');
+  end if;
+  update public.attendances set finished_at=now(),service_status_id=st.id,service_status_name=st.name,
+    counts_as_contact=st.counts_as_contact,counts_as_sale=false,notes=memo where id=a.id;
+  update public.campaign_leads set status='worked',worked_at=now(),last_attendance_id=a.id,last_service_status_id=st.id
+    where id=cl.id and (last_attendance_id=a.id or last_attendance_id is null);
+  return a.id;
+end $$;
+revoke all on function public.finish_pbx_attendance(jsonb) from public,anon;
+grant execute on function public.finish_pbx_attendance(jsonb) to authenticated;
+
+CREATE OR REPLACE FUNCTION public.finalize_sale_attendance(p_input jsonb) RETURNS uuid LANGUAGE plpgsql SECURITY INVOKER SET search_path = public AS $$
+DECLARE cl public.campaign_leads; st public.service_statuses; cfg public.sale_form_configs; pr jsonb; fld jsonb; val jsonb; att_id uuid; sale_id uuid; uid uuid := auth.uid(); tid uuid := public.current_tenant_id(); start_time timestamptz; end_time timestamptz := now();
+BEGIN
+ IF uid IS NULL OR tid IS NULL THEN RAISE EXCEPTION 'Acesso não autorizado'; END IF;
+ SELECT * INTO cl FROM public.campaign_leads WHERE id = (p_input->>'campaignLeadId')::uuid AND tenant_id = tid FOR UPDATE;
+ IF p_input ? 'pbxAttendanceId' THEN
+   IF NOT public.pbx_wrapup_ready((p_input->>'pbxAttendanceId')::uuid,cl.id) THEN
+     SELECT s.id INTO sale_id FROM public.sales s JOIN public.attendances a ON a.id=s.attendance_id WHERE a.id=(p_input->>'pbxAttendanceId')::uuid AND a.user_id=uid AND a.tenant_id=tid AND a.lead_id=cl.lead_id AND a.campaign_id=cl.campaign_id AND a.finished_at IS NOT NULL;
+     IF sale_id IS NOT NULL THEN RETURN sale_id; END IF;
+     RAISE EXCEPTION 'Aguarde o encerramento da ligação ou confira o atendimento';
+   END IF;
+ ELSIF cl.id IS NULL OR cl.status <> 'pending' OR cl.locked_by IS DISTINCT FROM uid THEN RAISE EXCEPTION 'Este atendimento não está aberto para você'; END IF;
+ SELECT * INTO st FROM public.service_statuses WHERE id = (p_input->>'statusId')::uuid AND tenant_id = tid AND active AND deleted_at IS NULL;
+ IF st.id IS NULL OR NOT st.counts_as_sale THEN RAISE EXCEPTION 'Selecione uma tabulação de venda'; END IF;
+ IF length(coalesce(p_input->>'notes','')) > 10000 OR (st.requires_note AND btrim(coalesce(p_input->>'notes','')) = '') THEN RAISE EXCEPTION 'Informe uma observação válida'; END IF;
+ SELECT * INTO cfg FROM public.sale_form_configs WHERE tenant_id = tid;
+ IF jsonb_typeof(p_input->'values') IS DISTINCT FROM 'object' THEN RAISE EXCEPTION 'Formulário inválido'; END IF;
+ IF cfg.id IS NOT NULL AND jsonb_array_length(cfg.products) > 0 THEN
+ SELECT x INTO pr FROM jsonb_array_elements(cfg.products) x WHERE x->>'id' = p_input->>'productId';
+ IF pr IS NULL THEN RAISE EXCEPTION 'Selecione o produto vendido'; END IF;
+ END IF;
+ FOR fld IN SELECT x FROM jsonb_array_elements(coalesce(cfg.fields,'[]')) x LOOP
+ IF jsonb_array_length(fld->'productIds') > 0 AND NOT (fld->'productIds' ? coalesce(p_input->>'productId','')) THEN CONTINUE; END IF;
+ val := p_input->'values'->(fld->>'id');
+ IF (fld->>'required')::boolean AND (val IS NULL OR val = 'null'::jsonb OR val = '""'::jsonb OR val = 'false'::jsonb) THEN RAISE EXCEPTION 'Preencha o campo %', fld->>'label'; END IF;
+ IF val IS NULL OR val = '""'::jsonb OR val = 'null'::jsonb THEN CONTINUE; END IF;
+ IF fld->>'type' IN ('number','currency') AND (jsonb_typeof(val) <> 'number' OR (val::text)::numeric < 0 OR (val::text)::numeric > 1000000000) THEN RAISE EXCEPTION 'Número inválido'; END IF;
+ IF fld->>'type' = 'select' AND NOT (fld->'options' ? (val #>> '{}')) THEN RAISE EXCEPTION 'Opção inválida'; END IF;
+ IF fld->>'type' = 'file' AND (jsonb_typeof(val) <> 'object' OR coalesce(val->>'path','') NOT LIKE tid::text || '/' || uid::text || '/%' OR NOT EXISTS (SELECT 1 FROM storage.objects o WHERE o.bucket_id = 'sale-documents' AND o.name = val->>'path')) THEN RAISE EXCEPTION 'Anexo inválido'; END IF;
+ IF fld->>'type' = 'address' AND (jsonb_typeof(val) <> 'object' OR coalesce(val->>'cep','') !~ '^[0-9]{8}$' OR btrim(coalesce(val->>'street','')) = '' OR btrim(coalesce(val->>'number','')) = '' OR btrim(coalesce(val->>'city','')) = '' OR coalesce(val->>'state','') !~ '^[A-Z]{2}$') THEN RAISE EXCEPTION 'Endereço incompleto'; END IF;
+ IF length(val::text) > 6000 THEN RAISE EXCEPTION 'Campo muito longo'; END IF;
+ END LOOP;
+ IF st.requires_appointment AND p_input->'appointment' IS NULL THEN RAISE EXCEPTION 'Agendamento obrigatório'; END IF;
+ start_time := (p_input->>'startedAt')::timestamptz;
+ IF start_time > end_time OR start_time < end_time - interval '7 days' THEN RAISE EXCEPTION 'Horário de atendimento inválido'; END IF;
+ IF p_input ? 'pbxAttendanceId' THEN
+   UPDATE public.attendances SET finished_at=end_time,service_status_id=st.id,service_status_name=st.name,counts_as_contact=st.counts_as_contact,counts_as_sale=true,notes=nullif(p_input->>'notes','') WHERE id=(p_input->>'pbxAttendanceId')::uuid AND finished_at IS NULL AND tenant_id=tid AND user_id=uid RETURNING id INTO att_id;
+ ELSE
+ INSERT INTO public.attendances(tenant_id,lead_id,campaign_id,campaign_name,user_id,user_name,service_status_id,service_status_name,counts_as_contact,counts_as_sale,started_at,finished_at,duration_seconds,notes,phone)
+ SELECT tid,cl.lead_id,cl.campaign_id,c.name,uid,p.full_name,st.id,st.name,st.counts_as_contact,true,start_time,end_time,greatest(0,extract(epoch FROM end_time-start_time)::integer),nullif(p_input->>'notes',''),p_input->>'phone' FROM public.profiles p JOIN public.campaigns c ON c.id=cl.campaign_id WHERE p.id=uid RETURNING id INTO att_id;
+ END IF;
+ IF att_id IS NULL THEN RAISE EXCEPTION 'Perfil inválido'; END IF;
+ INSERT INTO public.sales(tenant_id,lead_id,campaign_id,attendance_id,user_id,amount,product_id,product_name,form_snapshot,form_data)
+ VALUES(tid,cl.lead_id,cl.campaign_id,att_id,uid,(p_input->>'amount')::numeric,pr->>'id',pr->>'name',jsonb_build_object('name',coalesce(cfg.name,'Cadastro de venda'),'fields',coalesce(cfg.fields,'[]'),'product',pr),p_input->'values') RETURNING id INTO sale_id;
+ IF p_input->'appointment' IS NOT NULL AND p_input->'appointment' <> 'null'::jsonb THEN
+ INSERT INTO public.appointments(tenant_id,lead_id,campaign_id,attendance_id,user_id,scheduled_at,notes,priority) VALUES(tid,cl.lead_id,cl.campaign_id,att_id,uid,(p_input->'appointment'->>'scheduledAt')::timestamptz,nullif(p_input->>'notes',''),p_input->'appointment'->>'priority');
+ END IF;
+ UPDATE public.campaign_leads SET status='worked',worked_at=end_time,last_attendance_id=att_id,last_service_status_id=st.id,locked_by=NULL,locked_at=NULL,lock_expires_at=NULL WHERE id=cl.id;
+ RETURN sale_id;
+END $$;
