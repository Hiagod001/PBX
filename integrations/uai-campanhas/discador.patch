@@ -0,0 +1,59 @@
+import { useEffect, useState } from "react";
+import { supabase } from "@/integrations/supabase/client";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+
+type Call = {name:string; document:string; phone:string; campaign:string; cidade:string; uf:string; extra:Record<string,unknown>};
+type Desk = {extension:string; call:Call|null};
+
+async function request(path:string, options?:RequestInit) {
+  const {data} = await supabase.auth.getSession();
+  if (!data.session) throw new Error("Entre novamente para vincular seu ramal.");
+  const res=await fetch("/backend/pbx/"+path,{...options,headers:{Authorization:"Bearer "+data.session.access_token,"Content-Type":"application/json"},cache:"no-store"});
+  if(res.status===204) return null;
+  const result=await res.json();
+  if(!res.ok) throw new Error(result.message || "Não foi possível consultar o Discador.");
+  return result;
+}
+
+export function PbxDesk() {
+  const [desk,setDesk]=useState<Desk|null>(null);
+  const [editing,setEditing]=useState(false);
+  const [message,setMessage]=useState("");
+  const [busy,setBusy]=useState(false);
+  useEffect(()=>{
+    let active=true;
+    let timer:ReturnType<typeof setTimeout>;
+    async function refresh(){
+      let delay=3000;
+      try { const next=await request("desk"); if(active) setDesk(next); if(!next.extension) delay=15000; }
+      catch { delay=15000; if(active) setDesk(null); }
+      if(active) timer=setTimeout(refresh,delay);
+    }
+    void refresh();
+    return ()=>{active=false;clearTimeout(timer);};
+  },[]);
+  const call=desk?.call;
+  return <section aria-label="Ramal do Discador" className="border-b bg-card px-4 py-2 text-sm lg:px-8">
+    <div className="flex flex-wrap items-center gap-3"><strong>{desk?.extension ? "Ramal "+desk.extension : "Discador"}</strong>
+      <Button size="sm" variant="outline" onClick={()=>setEditing(!editing)}>{editing?"Fechar":desk?.extension?"Alterar ramal":"Vincular meu ramal"}</Button></div>
+    {editing && <form className="mt-2 flex flex-wrap items-end gap-2" onSubmit={async e=>{
+      e.preventDefault(); const data=new FormData(e.currentTarget); setBusy(true); setMessage("");
+      try {const result=await request("binding",{method:"POST",body:JSON.stringify(Object.fromEntries(data))});setDesk({extension:result.extension,call:null});setEditing(false);}
+      catch(err){setMessage((err as Error).message);} finally{setBusy(false);}
+    }}>
+      <label>Ramal<Input name="extension" inputMode="numeric" pattern="[0-9]{2,8}" maxLength={8} required defaultValue={desk?.extension}/></label>
+      <label>Senha do ramal<Input name="password" type="password" maxLength={128} required /></label>
+      <Button size="sm" disabled={busy}>Vincular</Button>
+      {desk?.extension && <Button type="button" size="sm" variant="outline" disabled={busy} onClick={async()=>{
+        setBusy(true);try{await request("binding",{method:"DELETE"});setDesk({extension:"",call:null});setEditing(false);setMessage("");}catch(err){setMessage((err as Error).message);}finally{setBusy(false);}
+      }}>Desvincular</Button>}
+    </form>}
+    {message && <p role="alert">{message}</p>}
+    {call && <div aria-live="polite" className="my-2 rounded-md border-l-4 border-primary bg-muted p-3">
+      <p className="text-xs">{call.campaign} · Em atendimento</p><strong>{call.name}</strong>
+      <p>{[call.phone,call.document && "CPF/CNPJ "+call.document,call.cidade,call.uf].filter(Boolean).join(" · ")}</p>
+      {Object.entries(call.extra||{}).filter(([,v])=>typeof v==="string"||typeof v==="number").map(([key,value])=><p key={key}>{key}: {String(value)}</p>)}
+    </div>}
+  </section>;
+}
