diff --git a/drizzle/migrations/0025_pbx_dialer.sql b/drizzle/migrations/0025_pbx_dialer.sql
new file mode 100644
--- /dev/null
+++ b/drizzle/migrations/0025_pbx_dialer.sql
@@ -0,0 +1,22 @@
+create schema if not exists pbx_private;
+revoke all on schema pbx_private from public, anon, authenticated;
+create table pbx_private.integrations (
+  tenant_id uuid primary key references public.tenants(id), token_hash text unique not null
+);
+create table pbx_private.bindings (
+  id bigint generated always as identity primary key, tenant_id uuid not null, extension text not null,
+  session_id uuid not null, user_id uuid not null, started_at timestamptz not null default now(), ended_at timestamptz
+);
+create unique index pbx_active_extension on pbx_private.bindings(tenant_id,extension) where ended_at is null;
+create unique index pbx_active_session on pbx_private.bindings(session_id) where ended_at is null;
+create function pbx_private.end_binding() returns trigger language plpgsql as $$
+begin
+  update pbx_private.bindings set ended_at=least(now(),old.expires_at) where session_id=old.id and ended_at is null;
+  return old;
+end $$;
+create trigger pbx_end_binding before delete on auth.sessions for each row execute function pbx_private.end_binding();
+create table pbx_private.calls (
+  tenant_id uuid not null, attempt text not null, extension text not null, binding_id bigint references pbx_private.bindings,
+  attendance_id uuid not null unique references public.attendances(id) on delete cascade, primary key(tenant_id,attempt)
+);
+create index pbx_calls_binding on pbx_private.calls(binding_id);
