PORT=3090
HOST=0.0.0.0
NODE_ENV=production
SESSION_SECRET=troque-este-segredo-em-producao
# Usada somente na primeira inicializacao, antes de existir um administrador.
# PBX_INITIAL_ADMIN_PASSWORD=troque-esta-senha

# Mantem o processo na porta atual, mas recusa acesso externo sem HTTPS.
# O acesso local em 127.0.0.1 continua disponivel para verificacoes de saude.
PBX_REQUIRE_HTTPS=true
PBX_PUBLIC_URL=https://pbx.seudominio.com.br

# PostgreSQL. Quando configurado, o painel passa a gravar configuracoes,
# usuarios, URAs, filas, ramais, auditoria, presenca e CDR em banco.
# DATABASE_URL=postgres://pbx:senha-forte@127.0.0.1:5432/pbx
# PBX_DATABASE_REQUIRED=false
# PBX_CDR_DB_LIMIT=50000
# PBX_CDR_IMPORT_INTERVAL_MS=60000

# Backup automatico do PostgreSQL, executado pelo proprio processo do PBX.
# PBX_BACKUP_INTERVAL_HOURS=24
# PBX_BACKUP_RETENTION=14
# PBX_BACKUP_DIR=/caminho/seguro/para/backups

# Rotacao restrita aos arquivos de log deste PBX no PM2.
# PBX_PM2_APP_NAME=pbx-UAI
# PBX_LOG_MAX_MB=25
# PBX_LOG_RETENTION=14

# IP publico ou DNS usado por telefones externos.
# Preencha tambem no painel em Seguranca > Endereco publico.
# PUBLIC_ADDRESS=seu-ip-ou-dns

# Opcional: se quiser aplicar direto no Asterisk instalado no host.
# Recomendado testar primeiro em generated/asterisk.
# ASTERISK_CONFIG_DIR=/etc/asterisk
# ASTERISK_RELOAD_CMD=asterisk -rx "module reload res_pjsip.so"
# Se o helper estiver fora da pasta em execucao, informe o projeto como argumento.
# ASTERISK_APPLY_CMD="sudo -n /opt/pbx-sip-admin/scripts/apply-root.sh /caminho/do/PBX"
# ASTERISK_CONTROL_HELPER=/opt/pbx-sip-admin/scripts/asterisk-control-root.sh

# Softphone no navegador. Use WSS em producao com certificado valido no Asterisk.
# BROWSER_SIP_DOMAIN=pbx.seudominio.com.br
# BROWSER_SIP_WS=wss://pbx.seudominio.com.br:8089/ws

# Caminho opcional para CDR CSV do Asterisk.
# ASTERISK_CDR_CSV=/var/log/asterisk/cdr-csv/Master.csv
