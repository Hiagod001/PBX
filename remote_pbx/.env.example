PORT=3090
HOST=0.0.0.0
SESSION_SECRET=troque-este-segredo-em-producao

# PostgreSQL. Quando configurado, o painel passa a gravar configuracoes,
# usuarios, URAs, filas, ramais, auditoria, presenca e CDR em banco.
# DATABASE_URL=postgres://pbx:senha-forte@127.0.0.1:5432/pbx
# PBX_DATABASE_REQUIRED=false
# PBX_CDR_DB_LIMIT=50000

# IP publico ou DNS usado por telefones externos.
# Preencha tambem no painel em Seguranca > Endereco publico.
# PUBLIC_ADDRESS=seu-ip-ou-dns

# Opcional: se quiser aplicar direto no Asterisk instalado no host.
# Recomendado testar primeiro em generated/asterisk.
# ASTERISK_CONFIG_DIR=/etc/asterisk
# ASTERISK_RELOAD_CMD=asterisk -rx "core reload"
# ASTERISK_APPLY_CMD="sudo -n /opt/pbx-sip-admin/scripts/apply-root.sh"
# ASTERISK_CONTROL_HELPER=/opt/pbx-sip-admin/scripts/asterisk-control-root.sh

# Softphone no navegador. Use WSS em producao com certificado valido no Asterisk.
# BROWSER_SIP_DOMAIN=pbx.seudominio.com.br
# BROWSER_SIP_WS=wss://pbx.seudominio.com.br:8089/ws

# Caminho opcional para CDR CSV do Asterisk.
# ASTERISK_CDR_CSV=/var/log/asterisk/cdr-csv/Master.csv
