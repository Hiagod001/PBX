{
  "name": "uai-pbx-ramal",
  "version": "1.0.3",
  "description": "App simples do ramal UAI PBX",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "check": "node --check main.js && node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist": "electron-builder --win nsis --x64 --config.win.signAndEditExecutable=false --config.win.signDlls=false"
  },
  "build": {
    "appId": "br.com.uaitelecom.uaipbxramal",
    "productName": "UAI PBX Ramal",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "*.wav",
          "*.ico",
          "audio/*.dll"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "afterPack": "scripts/after-pack.js",
    "afterAllArtifactBuild": "scripts/after-all-artifact-build.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UAI PBX Ramal",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "installer/installer-icons.nsh"
    }
  },
  "devDependencies": {
    "@electron/asar": "^3.2.17",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "rcedit": "^4.0.1"
  }
}
